---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import HubCard from '@components/HubCard.astro'
import { Heading } from 'accessible-astro-components'
---

<DefaultLayout title="Classroom tools" description="Reusable HPE classroom tools.">
  <section class="container section">
    <Heading level="h1">Classroom tools</Heading>
    <p>Reusable tools that can support learning across more than one unit or year level.</p>
    <div class="grid"><HubCard title="Brain Break Spinner" description="Pick calming or energising, spin the wheel, and run the break it lands on with a built-in timer." href="/activities/Brain_Break_Spinner.html" label="Any class · 1–3 min" /></div>
  </section>
</DefaultLayout>

<style>
  .section { padding-block: clamp(3rem, 8vw, 6rem); } .grid { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); margin-top: var(--space-l); } .empty { border-inline-start: .35rem solid var(--color-secondary-500); margin-top: var(--space-l); padding-inline-start: var(--space-m); }
</style>
