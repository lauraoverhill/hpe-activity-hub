---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import HubCard from '@components/HubCard.astro'
import { Heading } from 'accessible-astro-components'
---

<DefaultLayout title="HPE Activity Hub" useTitleTemplate={false}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Health &amp; Physical Education</p>
      <Heading level="h1">Practical HPE learning, ready for the classroom.</Heading>
      <p class="lede">A public library of inclusive activities, teaching resources, unit material, and classroom tools.</p>
    </div>
  </section>

  <section class="container section" aria-labelledby="choose-heading">
    <Heading level="h2" id="choose-heading">Choose your pathway</Heading>
    <p class="intro">Everything is publicly accessible. The two pathways make it clear whether material is designed for learners or for educators.</p>
    <div class="grid">
      <HubCard title="Explore units" label="For learners" href="/units" description="Choose a topic and open student-facing activities, scenarios, quizzes, and interactive learning experiences." />
      <HubCard title="Teacher resources" label="For educators" href="/teach" description="Lesson plans, facilitation guidance, printable resources, assessment material, and curriculum notes." />
    </div>
  </section>

  <section class="container section" aria-labelledby="library-heading">
    <Heading level="h2" id="library-heading">Browse the library</Heading>
    <div class="grid grid-three">
      <HubCard title="Units" href="/units" description="Grouped collections of teaching and learning material by topic and year level." />
      <HubCard title="Classroom tools" href="/tools" description="Reusable tools that support learning across units and year levels." />
      <HubCard title="Accessibility" href="/accessibility-statement" description="Our commitment to making these resources usable by as many people as possible." />
    </div>
  </section>
</DefaultLayout>

<style>
  .hero { background: linear-gradient(135deg, var(--color-primary-100), var(--color-secondary-100)); padding-block: clamp(4rem, 12vw, 9rem); }
  .hero h1 { max-width: 16ch; }
  .eyebrow { color: var(--color-primary-700); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .lede, .intro { font-size: var(--step-1); max-width: 58ch; }
  .section { padding-block: clamp(3rem, 8vw, 6rem); }
  .section > h2 { margin-bottom: var(--space-s); }
  .grid { display: grid; gap: var(--space-m); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); margin-top: var(--space-l); }
  @media (min-width: 64rem) { .grid-three { grid-template-columns: repeat(3, 1fr); } }
</style>
