---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import ActivityCard from '@components/ActivityCard.astro'
import { activities, phases } from '@data/hpe'
---
<DefaultLayout title="Illicit Drugs" description="Year 8 unit on party safety, dependence and prescription medicine.">
  <div class="unit">
    <header class="hero content"><p class="eyebrow">Year 8 Health</p><h1>Making <span>Safer</span> Choices</h1><p class="lede">Your class activity hub. Every interactive task for the unit lives here — open one, have a go, and learn how to make safer choices and help others do the same.</p><ul class="facts"><li>15 lessons</li><li>Harm minimisation approach</li><li>Tap a card to start</li></ul></header>
    {phases.map(([title, lessons], index) => <section class="phase content"><header><p class="phase-number">{index + 1}</p><h2>{title}</h2><span>{lessons}</span></header><div class="cards">{activities.filter((activity) => activity.phase === index + 1).map((activity) => <ActivityCard lesson={activity.lesson} type={activity.type} title={activity.title} description={activity.description} href={'/activities/' + activity.file} />)}</div>{(index === 3 || index === 6) && <p class="assessment">Assessment material is handed out in class.</p>}</section>)}
    <section class="support content" aria-labelledby="support-heading"><div><h2 id="support-heading">Need to talk to someone?</h2><p>These are free, private services in Australia. It's okay to reach out — for yourself or for a friend.</p></div><div class="support-links"><a href="tel:1800551800"><strong>Kids Helpline</strong><span>1800 55 1800</span><small>Ages 5–25 · 24/7</small></a><a href="tel:1300858584"><strong>ADF DrugInfo</strong><span>1300 85 85 84</span><small>Alcohol &amp; Drug Foundation</small></a><a href="tel:131114"><strong>Lifeline</strong><span>13 11 14</span><small>Crisis support · 24/7</small></a><a href="https://au.reachout.com" target="_blank" rel="noopener noreferrer"><strong>ReachOut</strong><span>au.reachout.com</span><small>Youth wellbeing info</small></a></div></section>
  </div>
</DefaultLayout>
<style>
  .unit { background:#eef2f9; padding-block:clamp(2.25rem,6vw,5rem); } .content { margin-inline:auto; max-width:940px; padding-inline:1.35rem; } .hero { padding-bottom:clamp(2rem,5vw,4rem); } .eyebrow { color:#5b5d86; font-size:.72rem; font-weight:800; letter-spacing:.12em; margin:0 0 .6rem; text-transform:uppercase; } h1 { color:#2e2f5b; font-size:clamp(3rem,7vw,5.2rem); font-weight:900; letter-spacing:-.07em; line-height:.92; margin:0; max-width:11ch; } h1 span { background:#9fb9e4; border-radius:.35rem; padding-inline:.1em; } .lede { color:#5b5d86; font-size:1rem; line-height:1.5; margin-top:1.3rem; max-width:60ch; } .facts { color:#5b5d86; display:flex; flex-wrap:wrap; font-size:.78rem; gap:1.1rem; list-style:none; margin:1.45rem 0 0; padding:0; } .facts li::before { color:#2e2f5b; content:'•'; font-size:1.15em; margin-right:.35rem; } .phase { border-top:1px solid #cbd8ef; margin-top:2rem; padding-top:1.55rem; } .phase header { align-items:center; display:flex; flex-wrap:wrap; gap:.65rem; } .phase-number { align-items:center; background:#2e2f5b; border-radius:.38rem; color:#fff; display:inline-flex; font-size:.76rem; font-weight:800; height:1.5rem; justify-content:center; margin:0; width:1.5rem; } .phase header h2 { color:#2e2f5b; font-size:clamp(1.3rem,3vw,1.7rem); font-weight:850; letter-spacing:-.03em; line-height:1.1; margin:0; } .phase header span { color:#5b5d86; font-size:.8rem; } .cards { display:grid; gap:.85rem; grid-template-columns:repeat(auto-fit,minmax(min(100%,16rem),1fr)); margin-top:1rem; } .assessment { border-inline-start:.35rem solid #91adda; color:#5b5d86; padding-inline-start:var(--space-m); } .support { background:#2e2f5b; border-radius:18px; color:#fff; display:grid; gap:var(--space-l); grid-template-columns:minmax(0,.9fr) minmax(0,1.35fr); margin-top:3rem; padding-block:clamp(1.5rem,4vw,2.5rem); } .support h2 { font-size:var(--step-1); } .support p { color:#d6deee; margin-block:var(--space-s) 0; max-width:38ch; } .support-links { display:grid; gap:var(--space-s); grid-template-columns:repeat(2,minmax(0,1fr)); } .support-links a { border:1px solid rgb(255 255 255 / 20%); border-radius:10px; color:#fff; display:flex; flex-direction:column; padding:var(--space-s) var(--space-m); text-decoration:none; } .support-links a:hover { background:rgb(255 255 255 / 8%); } .support-links span { color:#a9c5f4; font-weight:700; margin-top:.1rem; } .support-links small { color:#d6deee; margin-top:.25rem; } @media (max-width:48rem) { .support { grid-template-columns:1fr; } } @media (max-width:31rem) { .support-links { grid-template-columns:1fr; } }
</style>
