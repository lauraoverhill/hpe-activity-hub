---
import { Heading, Link } from 'accessible-astro-components'

const currentYear = new Date().getFullYear()
---

<footer>
  <section class="py-12">
    <div class="container grid gap-8 md:grid-cols-2">
      <div>
        <Heading level="h2" size="h4">HPE Activity Hub</Heading>
        <p class="mt-3 max-w-prose">Public teaching and learning material for health and physical education.</p>
      </div>
      <nav aria-label="Footer navigation">
        <Heading level="h2" size="h5">Explore</Heading>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
          <li><Link href="/units">Units</Link></li>
          <li><Link href="/teach">Teacher resources</Link></li>
          <li><Link href="/tools">Classroom tools</Link></li>
          <li><Link href="/accessibility-statement">Accessibility</Link></li>
        </ul>
      </nav>
    </div>
  </section>
  <section class="py-6">
    <div class="container"><p>&copy; {currentYear} HPE Activity Hub.</p></div>
  </section>
</footer>

<style>
  section { border-top: 1px solid var(--border-color-subtle); }
</style>
