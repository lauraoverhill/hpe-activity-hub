---
import { Link } from 'accessible-astro-components'

interface Props {
  title: string
  description: string
  href: string
  label?: string
}

const { title, description, href, label }: Props = Astro.props
---

<article class="hub-card">
  {label && <p class="eyebrow">{label}</p>}
  <h2>{title}</h2>
  <p>{description}</p>
  <Link href={href}>Explore <span aria-hidden="true">&rarr;</span></Link>
</article>

<style>
  .hub-card {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l);
  }

  .hub-card h2 { font-size: var(--step-2); font-weight: 700; }
  .hub-card p { margin: 0; }
  .hub-card a { margin-top: auto; font-weight: 700; }
  .eyebrow { color: var(--color-primary-600); font-size: var(--step--1); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
</style>
